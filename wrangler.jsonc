{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pathway",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "main": "worker/index.ts"
}
